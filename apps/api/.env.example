PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Postgres connection string (matches db/schema.sql)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploydoctor

# Groq API — used for diagnosis (Call A, gpt-oss-120b) and NL routing (Call B, gpt-oss-20b)
GROQ_API_KEY=
# GROQ_DIAGNOSE_MODEL=openai/gpt-oss-120b
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# Zerops platform API — used to read status/logs and trigger redeploys
ZEROPS_API_TOKEN=
ZEROPS_API_BASE=https://api.app-prg1.zerops.io/api/rest/public
# The Zerops service (patient app) this instance diagnoses/redeploys by default
ZEROPS_PROJECT_ID=
ZEROPS_SERVICE_ID=

# Optional — raises GitHub API rate limits for F7 repo fetches
GITHUB_TOKEN=
