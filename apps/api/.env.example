PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Postgres connection string (matches db/schema.sql)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploydoctor

# Groq API — used for diagnosis (Call A, gpt-oss-120b) and NL routing (Call B, gpt-oss-20b)
GROQ_API_KEY=
# GROQ_DIAGNOSE_MODEL=openai/gpt-oss-120b
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# Zerops platform API — used to read status/logs. Names avoid the ZEROPS_
# prefix: Zerops's own dashboard rejects user-defined env vars starting
# with it (reserved for its own).
API_TOKEN=
# The Zerops project/service (patient app) this instance diagnoses/watches
PATIENT_PROJECT_ID=
PATIENT_SERVICE_ID=

# F2 apply-fix — commits the corrected zerops.yaml straight to the patient
# repo instead of calling Zerops's deploy API directly (unconfirmed exact
# endpoint/payload shape); Zerops's own push-to-branch pipeline trigger
# redeploys it automatically, same as every other push in this project.
# PATIENT_REPO_TOKEN needs write access, unlike the read-only GITHUB_TOKEN
# below (which is used against whatever arbitrary public repo a user
# pastes for F7, not this one specific repo).
PATIENT_REPO_TOKEN=
PATIENT_REPO=HenryTech12/deploydoctor-patient-app
PATIENT_REPO_BRANCH=main
# PATIENT_REPO_YAML_PATH=zerops.yaml

# Optional — raises GitHub API rate limits for F7 repo fetches
GITHUB_TOKEN=
